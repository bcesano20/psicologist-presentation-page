---
import { Image } from 'astro:assets';
import astroLogo from '../assets/astro.svg';
---

<section
  id="hero-container"
  class="from-secondary-50 via-secondary-100 to-secondary-200 relative flex min-h-screen items-center justify-center overflow-hidden bg-linear-to-br"
>
  <!-- Background decorative blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="bg-primary-200 absolute -top-24 -right-24 h-96 w-96 rounded-full opacity-40 blur-3xl"
    >
    </div>
    <div
      class="bg-accent-200 absolute -bottom-24 -left-24 h-96 w-96 rounded-full opacity-40 blur-3xl"
    >
    </div>
    <div
      class="bg-primary-100 absolute top-1/2 left-1/2 h-150 w-150 -translate-x-1/2 -translate-y-1/2 rounded-full opacity-20 blur-3xl"
    >
    </div>
  </div>

  <div
    class="relative mx-auto flex max-w-6xl flex-col items-center gap-12 px-4 py-10 sm:px-8 lg:flex-row"
  >
    <!-- Text content -->
    <div class="flex-1 text-center lg:text-left" data-animate="fade-right">
      <h1
        class="text-primary-900 mb-4 text-5xl leading-tight font-extrabold sm:text-6xl lg:text-7xl"
      >
        Hola, soy
        <span class="text-primary-600"> Lourdes</span>
        <span class="text-primary-600 block">Villanueva</span>
      </h1>

      <p class="text-primary-700 mb-4 text-xl font-medium sm:text-2xl">Psicóloga clínica</p>

      <p
        class="text-secondary-900/70 mx-auto mb-10 max-w-xl text-base leading-relaxed sm:text-lg lg:mx-0"
      >
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus sit amet molestie urna.
        Etiam volutpat, arcu quis efficitur vehicula, sapien augue faucibus turpis, vitae congue
        elit nulla aliquet risus.
      </p>

      <div class="flex flex-wrap justify-center gap-4 lg:justify-start">
        <a
          href="#psicoterapist"
          class="bg-primary-600 text-secondary-50 shadow-primary-300/50 hover:bg-primary-700 hover:shadow-primary-400/50 rounded-full px-6 py-3 font-semibold shadow-lg transition-all hover:-translate-y-0.5"
        >
          Psicoterapias
        </a>
        <a
          href="#contact"
          class="border-primary-200 bg-secondary-50 text-primary-700 hover:border-primary-400 hover:text-primary-800 rounded-full border px-6 py-3 font-semibold transition-all hover:-translate-y-0.5"
        >
          Contactame
        </a>
      </div>
    </div>

    <!-- Avatar / decorative card -->
    <div class="relative shrink-0" data-animate="fade-left" style="--animate-delay: 150ms">
      <div
        class="from-primary-400 via-primary-500 to-accent-500 shadow-primary-300/50 relative flex h-64 w-64 items-center justify-center overflow-hidden rounded-3xl bg-linear-to-br p-10 shadow-2xl sm:h-80 sm:w-80"
      >
        <Image src={astroLogo} alt="Lourdes Villanueva" class="h-full w-full object-contain" />
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="text-primary-700/60 absolute bottom-8 left-1/2 flex -translate-x-1/2 animate-bounce flex-col items-center gap-1 text-xs"
  >
    <span>Mira mas abajo</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-4 w-4"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </div>
</section>
