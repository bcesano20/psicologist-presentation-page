---
const links = [
  {
    label: 'Email',
    value: 'mail@gmail.com',
    href: 'mailto:mail@gmail.com',
    description: 'La mejor forma de contactarme',
    color: 'bg-primary-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  },
  {
    label: 'WhatsApp',
    value: '+54 9 11 0000-0000',
    href: 'https://wa.me/5491100000000',
    description: 'Escribime directamente',
    color: 'bg-green-500',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/></svg>`,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/lourdesvillanueva',
    href: 'https://www.linkedin.com/in/lourdes-villanueva/',
    description: 'Para conectar profesionalmente',
    color: 'bg-blue-600',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<section id="contact" class="bg-primary-600 py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-8">
    <!-- Section header -->
    <div class="mb-16 text-center" data-animate="fade-up">
      <h2 class="text-secondary-500 mt-2 text-4xl font-extrabold sm:text-5xl">Contacto</h2>
      <div class="bg-secondary-100 mx-auto mt-4 h-1 w-16 rounded-full"></div>
    </div>

    <!-- Main CTA card -->
    <div
      class="bg-linear-br from-primary-600 to-primary-800 shadow-primary-200 relative mb-10 overflow-hidden rounded-3xl p-8 text-center text-white shadow-2xl sm:p-12"
      data-animate="zoom-in"
    >
      <div
        class="absolute top-0 right-0 h-48 w-48 translate-x-1/2 -translate-y-1/2 rounded-full bg-white/5"
      >
      </div>
      <div
        class="bg-accent-400/10 absolute bottom-0 left-0 h-32 w-32 -translate-x-1/2 translate-y-1/2 rounded-full"
      >
      </div>

      <div class="relative">
        <div
          class="bg-secondary-400 mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl shadow-lg"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-8 w-8 text-slate-900"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            ></path>
          </svg>
        </div>
        <h3 class="mb-3 text-2xl font-bold sm:text-3xl">Lorem ipsum dolor</h3>
        <p class="text-primary-200 mx-auto mb-8 max-w-xl text-lg">Lorem ipsum dolor</p>

        <!-- Contact form: submission is not wired up yet, markup/styling only -->
        <!-- TODO: Add Resend Email Implementation -->
        <form class="mx-auto max-w-xl space-y-4 text-left">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="text-primary-200 mb-1 block text-sm font-medium">
                Nombre
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                autocomplete="name"
                required
                placeholder="Tu nombre"
                class="placeholder:text-primary-200/60 focus:border-secondary-400 focus:ring-secondary-400 w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-white focus:ring-2 focus:outline-none"
              />
            </div>
            <div>
              <label for="contact-email" class="text-primary-200 mb-1 block text-sm font-medium">
                Email
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                autocomplete="email"
                required
                placeholder="tu@email.com"
                class="placeholder:text-primary-200/60 focus:border-secondary-400 focus:ring-secondary-400 w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-white focus:ring-2 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="contact-message" class="text-primary-200 mb-1 block text-sm font-medium">
              Mensaje
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Contame en que puedo ayudarte..."
              class="placeholder:text-primary-200/60 focus:border-secondary-400 focus:ring-secondary-400 w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-white focus:ring-2 focus:outline-none"
            ></textarea>
          </div>

          <div class="text-center">
            <button
              type="submit"
              class="bg-secondary-400 hover:bg-secondary-500 inline-flex items-center gap-2 rounded-full px-8 py-4 text-lg font-bold text-slate-900 shadow-lg transition-all hover:-translate-y-0.5"
            >
              Enviar mensaje
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Contact link cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            target={link.href.startsWith('mailto') ? '_self' : '_blank'}
            rel="noopener noreferrer"
            class="border-primary-100 hover:border-primary-300 group flex items-center gap-4 rounded-2xl border bg-white p-5 transition-all hover:shadow-md"
            data-animate="fade-up"
            style={`--animate-delay: ${i * 100}ms`}
          >
            <div
              class={`h-10 w-10 rounded-xl ${link.color} flex shrink-0 items-center justify-center text-white shadow-sm transition-transform group-hover:scale-110`}
            >
              <Fragment set:html={link.icon} />
            </div>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-800">{link.label}</p>
              <p class="truncate text-xs text-slate-400">{link.value}</p>
            </div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="group-hover:text-primary-500 ml-auto h-4 w-4 shrink-0 text-slate-300 transition-colors"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>
