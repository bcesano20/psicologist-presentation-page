---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Iniciar sesión · Admin">
  <main class="bg-secondary-100 flex min-h-screen items-center justify-center px-4">
    <div
      class="border-primary-100 w-full max-w-md rounded-3xl border bg-white p-8 shadow-xl sm:p-10"
    >
      <div class="mb-8 flex flex-col items-center text-center">
        <span
          class="bg-primary-700 text-secondary-50 mb-4 flex h-12 w-12 items-center justify-center rounded-lg text-lg font-bold shadow-md"
        >
          LV
        </span>
        <h1 class="text-primary-900 text-2xl font-bold">Panel de administración</h1>
        <p class="text-primary-600 mt-1 text-sm">Iniciá sesión para gestionar tus posts</p>
      </div>

      <!-- Login form: submission is not wired up yet, markup/styling only -->
      <form class="space-y-4">
        <div>
          <label for="login-email" class="text-primary-700 mb-1 block text-sm font-medium">
            Email
          </label>
          <input
            type="email"
            id="login-email"
            name="email"
            autocomplete="email"
            required
            placeholder="tu@email.com"
            class="border-primary-200 text-primary-900 focus:border-primary-400 focus:ring-primary-400 w-full rounded-xl border px-4 py-3 focus:ring-2 focus:outline-none"
          />
        </div>
        <div>
          <label for="login-password" class="text-primary-700 mb-1 block text-sm font-medium">
            Contraseña
          </label>
          <input
            type="password"
            id="login-password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="••••••••"
            class="border-primary-200 text-primary-900 focus:border-primary-400 focus:ring-primary-400 w-full rounded-xl border px-4 py-3 focus:ring-2 focus:outline-none"
          />
        </div>
        <button
          type="submit"
          class="bg-primary-600 text-secondary-50 hover:bg-primary-700 w-full rounded-full px-6 py-3 text-lg font-bold shadow-lg transition-all hover:-translate-y-0.5"
        >
          Ingresar
        </button>
      </form>

      <a
        href="/"
        class="text-primary-600 hover:text-primary-900 mt-6 block text-center text-sm transition-colors"
      >
        ← Volver al sitio
      </a>
    </div>
  </main>
</Layout>
